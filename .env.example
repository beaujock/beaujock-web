# Public address of the site (used for SEO: canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://beaujock.com

# Where order and contact forms are delivered (the Web Builder Manager)
WEB_BUILDER_EMAIL=info.beaujock@gmail.com

# Email sending over SMTP with Nodemailer. Without SMTP_HOST, submissions are
# printed to the server console in development and refused in production.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail address,
# SMTP_PASS=a Google "app password" (needs 2-step verification), not your normal password.
SMTP_HOST=
SMTP_PORT=465
# true for port 465, false for 587 (STARTTLS). Defaults from the port when left empty.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown on the email, e.g. "Beaujock Website <info.beaujock@gmail.com>". Defaults to SMTP_USER.
MAIL_FROM=
